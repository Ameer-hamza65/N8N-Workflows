    {
      "parameters": {
        "jsCode": "// 1. Get calendar events\nconst calendarEvents = $(\"Get Upcoming Bookings\").all(); \n\n// 2. Get existing IDs from Sheets safely\nlet notified = [];\ntry {\n  const sheetData = $(\"Read Notified Bookings\").all();\n  notified = sheetData.map(row => row.json['ID'] || '');\n} catch (e) {\n  // If the node hasn't run yet or is empty, notified stays []\n  notified = [];\n}\n\n// 3. Filter for truly NEW events\nconst newBookings = calendarEvents.filter(event => {\n  const eventId = event.json.id;\n  // If the ID isn't in our sheet yet, it's new!\n  return !notified.includes(eventId);\n});\n\nreturn newBookings;"
      },
