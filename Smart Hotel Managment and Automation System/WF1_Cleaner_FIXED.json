    {
      "parameters": {
        "jsCode": "const events = $input.all();\nconst schedule = events\n  .filter(e => {\n    const summary = (e.json.summary || '').toLowerCase();\n    // Only include real bookings, skip Airbnb blocked/unavailable dates\n    return !summary.includes('not available') && \n           !summary.includes('blocked') && \n           !summary.includes('unavailable') &&\n           summary !== '';\n  })\n  .sort((a, b) => {\n    const startA = a.json.start.dateTime || a.json.start.date;\n    const startB = b.json.start.dateTime || b.json.start.date;\n    return new Date(startA) - new Date(startB);\n  })\n  .map(e => {\n    const endStr = e.json.end.dateTime || e.json.end.date;\n    const checkout = new Date(endStr);\n    const guestName = e.json.summary || 'Guest';\n    return `🧹 ${checkout.toLocaleDateString('en-GB', {weekday:'short', day:'numeric', month:'short'})}: Clean after ${guestName} checkout (10am)`;\n  })\n  .join('\\n');\n\nif (!schedule) {\n  return [{json: { message: `*Bryson Road — ${new Date().toLocaleString('en-GB', {month:'long', year:'numeric'})}*\\n\\nNo cleanings scheduled this month. 🎉` }}];\n}\n\nreturn [{json: {\n  message: `*Bryson Road Cleaning Schedule — ${new Date().toLocaleString('en-GB', {month:'long', year:'numeric'})}*\\n\\n${schedule}\\n\\nPlease confirm you've seen this message.`\n}}];"
      },
