    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst today = now.toDateString();\nconst events = $input.all().map(e => e.json);\nlet action = 'none';\nlet reason = '';\n\nfor (const event of events) {\n  // FIX: Look for dateTime first, but fallback to date for Airbnb iCal events\n  const checkInDate = event.start.dateTime || event.start.date;\n  const checkOutDate = event.end.dateTime || event.end.date;\n  \n  if (!checkInDate || !checkOutDate) continue; \n\n  const checkIn = new Date(checkInDate);\n  const checkOut = new Date(checkOutDate);\n  \n  // Turn ON: 2 hours before 3PM check-in = 1PM on check-in day\n  const heatingOnTime = new Date(checkIn);\n  heatingOnTime.setHours(13, 0, 0); \n  \n  // Turn OFF: 10AM on check-out day\n  const heatingOffTime = new Date(checkOut);\n  heatingOffTime.setHours(10, 0, 0);\n  \n  const diffToOn = Math.abs(now - heatingOnTime) / 60000; // minutes\n  const diffToOff = Math.abs(now - heatingOffTime) / 60000;\n  \n  if (diffToOn < 30) { action = 'on'; reason = 'Guest check-in in 2 hours'; }\n  if (diffToOff < 30) { action = 'off'; reason = 'Guest checked out'; }\n  \n  // Keep ON during entire stay\n  if (now >= heatingOnTime && now <= heatingOffTime) { action = 'ensure_on'; }\n}\n\nreturn [{json: {action, reason}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        -16
      ],
